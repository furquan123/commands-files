                                                             Smart Lambda Code (No Instance IDs)


import boto3
from datetime import datetime

ec2 = boto3.client('ec2', region_name='ap-south-1')

def lambda_handler(event, context):
    
    current_time_utc = datetime.utcnow().strftime("%H:%M")

    response = ec2.describe_instances(
        Filters=[
            {'Name': 'tag:AutoSchedule', 'Values': ['OfficeHours']}
        ]
    )

    instance_ids = []
    for reservation in response['Reservations']:
        for instance in reservation['Instances']:
            instance_ids.append(instance['InstanceId'])

    if not instance_ids:
        return {"message": "No tagged instances found"}

    try:
        if current_time_utc == "04:55":
            ec2.start_instances(InstanceIds=instance_ids)
            return {"message": f"Started: {instance_ids}"}

        elif current_time_utc == "04:56":
            ec2.stop_instances(InstanceIds=instance_ids)
            return {"message": f"Stopped: {instance_ids}"}

        else:
            return {"message": f"No action at {current_time_utc} UTC"}

    except Exception as e:
        return {"error": str(e)}


