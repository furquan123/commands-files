            "error": str(e)
        }


def format_response(instances, action_word):
    result = []
    for i in instances:
        result.append({
            "InstanceId": i["InstanceId"],
            "PreviousState": i["PreviousState"]["Name"],
            "CurrentState": i["CurrentState"]["Name"]
        })
    
    return {
        "statusCode": 200,
        "message": f"Instances {action_word} successfully",
        "details": result
    }

