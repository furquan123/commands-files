            response = ec2.start_instances(InstanceIds=[instance_id])
            return {
                'statusCode': 200,
                'body': f"Instance {instance_id} starting... Response: {response}"
            }

        elif action == "stop":
            response = ec2.stop_instances(InstanceIds=[instance_id])
            return {
                'statusCode': 200,
                'body': f"Instance {instance_id} stopping... Response: {response}"
            }

        else:
            return {
                'statusCode': 400,
                'body': "Invalid action. Use 'start' or 'stop'."
            }

    except Exception as e:
        return {
            'statusCode': 500,
            'body': str(e)
        }

