    try:
        if current_time_utc == "04:35":
            response = ec2.start_instances(InstanceIds=instance_ids)
            return format_response(response['StartingInstances'], "started")

        elif current_time_utc == "04:36":
            response = ec2.stop_instances(InstanceIds=instance_ids)
            return format_response(response['StoppingInstances'], "stopped")

        else:
            return {
                "statusCode": 200,
